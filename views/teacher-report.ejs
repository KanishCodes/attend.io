<%- include("partials/header", { title: "Attendance Report", user: user }) %>

<div class="card max-w-1000 mt-2">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f4f7f6; padding-bottom: 1.5rem; margin-bottom: 2rem;">
        <div>
            <h1><i class="fa-solid fa-file-invoice accent-text"></i> Class Attendance Report</h1>
            <p>View cumulative attendance statistics for your subjects.</p>
        </div>
        <div style="text-align: right;">
            <a href="/mark-attendance" class="btn" style="background: var(--primary); padding: 0.6rem 1.5rem; text-decoration: none;">
                <i class="fa-solid fa-plus"></i> Mark Attendance
            </a>
        </div>
    </div>

    <!-- Subject Selection -->
    <div style="background: #fcfcfc; padding: 1.5rem; border-radius: 15px; border: 1px solid #eee; margin-bottom: 2rem;">
        <form action="/teacher-report" method="GET" style="display: flex; gap: 1rem; align-items: flex-end;">
            <div class="form-group" style="flex: 1; margin-bottom: 0;">
                <label for="subjectId">Select Subject to View Report</label>
                <select name="subjectId" id="subjectId" required onchange="this.form.submit()">
                    <option value="">-- Select Subject --</option>
                    <% subjects.forEach(subject => { %>
                        <option value="<%= subject._id %>" <%= selectedSubject && selectedSubject._id.toString() === subject._id.toString() ? 'selected' : '' %>>
                            <%= subject.name %> (<%= subject.code %>) - <%= subject.group %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <button type="submit" class="btn-success" style="padding: 0.8rem 1.5rem;">Fetch Report</button>
        </form>
    </div>

    <% if (selectedSubject) { %>
        <div style="background: #fff; padding: 1rem; border-radius: 12px; margin-bottom: 1rem;">
            <h3>Summary for: <span class="accent-text"><%= selectedSubject.name %></span></h3>
            <p style="color: #666; font-size: 0.9rem;">Target Group: <strong><%= selectedSubject.group %></strong></p>
        </div>

        <div class="table-container">
            <table style="width: 100%; border-collapse: separate; border-spacing: 0 8px;">
                <thead>
                    <tr style="color: #888; font-size: 0.85rem; text-transform: uppercase;">
                        <th style="padding: 1rem; text-align: left;">Student Name</th>
                        <th style="padding: 1rem; text-align: center;">Sessions Attended</th>
                        <th style="padding: 1rem; text-align: center;">Total Sessions</th>
                        <th style="padding: 1rem; text-align: right;">Final Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (studentStats.length === 0) { %>
                        <tr>
                            <td colspan="4" style="padding: 3rem; text-align: center; color: #aaa;">
                                <i class="fa-solid fa-users-slash" style="font-size: 2rem; display: block; margin-bottom: 1rem;"></i>
                                No students found in this group.
                            </td>
                        </tr>
                    <% } else { %>
                        <% studentStats.forEach(student => { %>
                            <tr style="background: #fafafa; transition: transform 0.2s;">
                                <td style="padding: 1rem; border-radius: 10px 0 0 10px;">
                                    <strong style="color: var(--text);"><%= student.name %></strong>
                                    <div style="font-size: 0.75rem; color: #999;"><%= student.email %></div>
                                </td>
                                <td style="padding: 1rem; text-align: center;">
                                    <span style="background: rgba(0,0,0,0.05); padding: 0.3rem 0.8rem; border-radius: 10px; font-weight: 600;">
                                        <%= student.present %>
                                    </span>
                                </td>
                                <td style="padding: 1rem; text-align: center; color: #888;">
                                    <%= student.total %>
                                </td>
                                <td style="padding: 1rem; text-align: right; border-radius: 0 10px 10px 0;">
                                    <strong style="font-size: 1.1rem; color: <%= parseFloat(student.percentage) < 75 ? '#e74c3c' : 'var(--text)' %>;">
                                        <%= student.percentage %>%
                                    </strong>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div style="text-align: center; padding: 5rem; border: 2px dashed #eee; border-radius: 20px;">
            <i class="fa-solid fa-magnifying-glass" style="font-size: 3rem; color: #eee; margin-bottom: 1.5rem;"></i>
            <p style="color: #999;">Please select a subject from the dropdown above to view the attendance report.</p>
        </div>
    <% } %>
</div>

<%- include("partials/footer") %>
