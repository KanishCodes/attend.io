<%- include("partials/header", { title: "attend.io - Smart Attendance" }) %>

<!-- Hero Section -->
<div style="text-align: center; padding: 4rem 1rem; margin-bottom: 2rem;">
    <h1 style="font-size: 3.5rem; font-weight: 800; letter-spacing: -0.05em; color: var(--text); margin-bottom: 1.5rem; line-height: 1.2;">
        Attendance management,<br>
        <span style="color: var(--primary);">reimagined for modern teams.</span>
    </h1>
    <p style="font-size: 1.2rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 2.5rem; line-height: 1.6;">
        A lightning-fast, highly secure platform designed to streamline academic workflows for both faculty and students.
    </p>

    <% if (typeof user !== 'undefined' && user._id) { %>
        <div style="background: white; padding: 2rem; border-radius: 16px; border: 1px solid var(--border); box-shadow: var(--shadow-lg); max-width: 600px; margin: 0 auto;">
            <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Welcome back, <%= user.firstName %>!</h2>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">You are logged in as a <strong><%= user.role %></strong>.</p>
            
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <% if (user.role === 'teacher') { %>
                    <a href="/manage-subjects" class="btn btn-secondary no-decoration">Manage Subjects</a>
                    <a href="/mark-attendance" class="btn no-decoration"><i class="fa-solid fa-clipboard-check"></i> Mark Attendance</a>
                <% } else { %>
                    <a href="/view-attendance" class="btn no-decoration"><i class="fa-solid fa-chart-pie"></i> View My Report</a>
                <% } %>
            </div>
        </div>
    <% } else { %>
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/signup" class="btn no-decoration" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Get Started Free</a>
            <a href="/login" class="btn btn-secondary no-decoration" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Sign In</a>
        </div>
    <% } %>
</div>

<!-- Features Section -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem;">
    <div style="background: var(--secondary); padding: 2rem; border-radius: 24px; border: none; box-shadow: none; transition: transform 0.2s; cursor: default;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="margin-bottom: 1.5rem;">
            <i class="fa-solid fa-bolt" style="color: var(--text); font-size: 2rem;"></i>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.8rem; color: var(--text);">Lightning Fast</h3>
        <p style="color: var(--text); opacity: 0.8; font-size: 0.95rem;">Built on Express.js and MongoDB, enjoy real-time updates and zero-latency page loads for seamless classroom management.</p>
    </div>

    <div style="background: var(--accent-pink); padding: 2rem; border-radius: 24px; border: none; box-shadow: none; transition: transform 0.2s; cursor: default;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="margin-bottom: 1.5rem;">
            <i class="fa-solid fa-shield-halved" style="color: var(--text); font-size: 2rem;"></i>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.8rem; color: var(--text);">Enterprise Security</h3>
        <p style="color: var(--text); opacity: 0.8; font-size: 0.95rem;">Protected by HTTP-only JWT cookies and Google OAuth 2.0 integration, ensuring your institutional data remains strictly confidential.</p>
    </div>

    <div style="background: var(--accent-blue); padding: 2rem; border-radius: 24px; border: none; box-shadow: none; transition: transform 0.2s; cursor: default;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="margin-bottom: 1.5rem;">
            <i class="fa-solid fa-chart-simple" style="color: var(--text); font-size: 2rem;"></i>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.8rem; color: var(--text);">Smart Analytics</h3>
        <p style="color: var(--text); opacity: 0.8; font-size: 0.95rem;">Automated attendance percentage calculations with dynamic shortage warnings, giving students instant clarity on their standing.</p>
    </div>
</div>

<!-- Bottom CTA -->
<% if (!user || !user._id) { %>
    <div style="text-align: center; margin: 5rem 0 2rem; background: var(--primary); padding: 4rem 2rem; border-radius: 24px; color: white;">
        <h2 style="color: white; font-size: 2rem; margin-bottom: 1rem;">Ready to upgrade your classroom?</h2>
        <p style="color: #E0E7FF; font-size: 1.1rem; margin-bottom: 2rem;">Join the platform that takes the hassle out of attendance tracking.</p>
        <a href="/signup" class="btn" style="background: white; color: var(--primary); padding: 1rem 2.5rem; font-size: 1.1rem; border-radius: 30px; text-decoration: none;">Create Free Account</a>
    </div>
<% } %>

<%- include("partials/footer") %>