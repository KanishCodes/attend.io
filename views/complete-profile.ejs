<%- include("partials/header", { title: "Complete Your Profile", user: user }) %>

<div class="card max-w-500 mt-2 text-center">
    <h1><i class="fa-solid fa-user-gear accent-text" style="padding: 0.5rem;"></i><br>Almost There!</h1>
    <p style="font-weight: 500;">Please provide a few more details to set up your account.</p>

    <form action="/complete-profile" method="POST" enctype="multipart/form-data" class="mt-1">
        <div class="form-group">
            <label for="profilePic">Profile Picture (Optional - Google Photo used by default)</label>
            <input type="file" id="profilePic" name="profilePic" accept="image/*">
        </div>
        <div class="form-group">
            <label for="role">Are you a Student or Teacher?<span class="required-star">*</span></label>
            <select id="role" name="role" required onchange="toggleFields()">
                <option value="student">Student</option>
                <option value="teacher">Teacher</option>
            </select>
        </div>

        <!-- Student Fields -->
        <div id="student-fields">
            <div class="form-group">
                <label for="batch">Batch<span class="required-star">*</span></label>
                <input type="text" id="batch" name="batch" placeholder="e.g. 2022-2026" required>
            </div>
            <div class="form-group">
                <label for="semester">Semester<span class="required-star">*</span></label>
                <input type="text" id="semester" name="semester" placeholder="e.g. 4th" required>
            </div>
            <div class="form-group">
                <label for="program">Program<span class="required-star">*</span></label>
                <input type="text" id="program" name="program" placeholder="e.g. B.Tech CSE" required>
            </div>
            <div class="form-group">
                <label for="group">Group<span class="required-star">*</span></label>
                <select name="group" id="group" required>
                    <option value="G-14">G-14</option>
                    <option value="G-15">G-15</option>
                    <option value="G-16">G-16</option>
                </select>
            </div>
        </div>

        <!-- Teacher Fields -->
        <div id="teacher-fields" style="display: none;">
            <div class="form-group">
                <label for="department">Department<span class="required-star">*</span></label>
                <input type="text" id="department" name="department" placeholder="e.g. Computer Science">
            </div>
            <div class="form-group">
                <label for="designation">Designation<span class="required-star">*</span></label>
                <input type="text" id="designation" name="designation" placeholder="e.g. Assistant Professor">
            </div>
        </div>

        <button type="submit">Complete Setup <i class="fa-solid fa-circle-right"></i></button>
    </form>

    <script>
        function toggleFields() {
            const role = document.getElementById('role').value;
            const studentFields = document.getElementById('student-fields');
            const teacherFields = document.getElementById('teacher-fields');
            
            const batch = document.getElementById('batch');
            const semester = document.getElementById('semester');
            const program = document.getElementById('program');
            const department = document.getElementById('department');
            const designation = document.getElementById('designation');

            if (role === 'student') {
                studentFields.style.display = 'block';
                teacherFields.style.display = 'none';
                batch.setAttribute('required', 'required');
                semester.setAttribute('required', 'required');
                program.setAttribute('required', 'required');
                department.removeAttribute('required');
                designation.removeAttribute('required');
            } else {
                studentFields.style.display = 'none';
                teacherFields.style.display = 'block';
                batch.removeAttribute('required');
                semester.removeAttribute('required');
                program.removeAttribute('required');
                department.setAttribute('required', 'required');
                designation.setAttribute('required', 'required');
            }
        }
    </script>
</div>

<%- include("partials/footer") %>
