<%- include("partials/header", { title: "Contact Us", user: typeof user !== 'undefined' ? user : null }) %>

<div class="card max-w-800 mt-2">
    <div style="text-align: center; border-bottom: 2px solid #f4f7f6; padding-bottom: 2rem; margin-bottom: 3rem;">
        <h1><i class="fa-solid fa-headset accent-text"></i> Contact Support</h1>
        <p>We're here to help you with any questions about your attendance records.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; text-align: center;">
        <!-- Location Card -->
        <div style="background: var(--secondary); padding: 2rem; border-radius: 20px; border: 1px solid #eee; transition: transform 0.3s;">
            <div style="background: #fff; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                <i class="fa-solid fa-location-dot accent-text" style="font-size: 1.5rem;"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem;">Visit Us</h3>
            <p style="color: #666; font-size: 0.9rem; line-height: 1.6;">
                Campus Drive, Tech Block 4<br>
                University Center, 110022<br>
                New Delhi, India
            </p>
        </div>

        <!-- Phone Card -->
        <div style="background: var(--accent-pink); padding: 2rem; border-radius: 20px; border: 1px solid #eee; transition: transform 0.3s;">
            <div style="background: #fff; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                <i class="fa-solid fa-phone accent-text" style="font-size: 1.5rem;"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem;">Call Us</h3>
            <p style="color: #666; font-size: 0.9rem; line-height: 1.6;">
                Support: +91 1800-ATTEND<br>
                Office: +91 011-2345-6789<br>
                Mon - Fri, 9am - 5pm
            </p>
        </div>

        <!-- Email Card -->
        <div style="background: var(--accent-green); padding: 2rem; border-radius: 20px; border: 1px solid #eee; transition: transform 0.3s;">
            <div style="background: #fff; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                <i class="fa-solid fa-envelope accent-text" style="font-size: 1.5rem;"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem;">Email Us</h3>
            <p style="color: #666; font-size: 0.9rem; line-height: 1.6;">
                General: support@attend.io<br>
                Admin: contact@university.edu<br>
                Response within 24hrs
            </p>
        </div>
    </div>

    <div class="mt-2 text-center" style="margin-top: 4rem; opacity: 0.7;">
        <p style="font-size: 0.85rem; color: #888;">&copy; 2026 attend.io | Empowering Education</p>
    </div>
</div>

<%- include("partials/footer") %>
